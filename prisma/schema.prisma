generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String         @id @default(cuid())
  clerkId   String         @unique
  name      String?
  email     String?
  workspaces Workspace[]
  comments  Comment[]
  activities ActivityLog[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  description String?
  owner       User      @relation(fields: [ownerId], references: [id])
  ownerId     String
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  workspaceId String
  name        String
  description String?
  boards      Board[]
  activities  ActivityLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Board {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  name      String
  tasks     Task[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String        @id @default(cuid())
  board       Board         @relation(fields: [boardId], references: [id])
  boardId     String
  title       String
  description String?
  dueDate     DateTime?
  order       Int?          @default(0)
  attachments Attachment[]
  comments    Comment[]
  labels      TaskLabel[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Label {
  id        String      @id @default(cuid())
  name      String
  color     String
  tasks     TaskLabel[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model TaskLabel {
  task    Task  @relation(fields: [taskId], references: [id])
  taskId  String
  label   Label @relation(fields: [labelId], references: [id])
  labelId String

  @@id([taskId, labelId])
}

model Attachment {
  id        String @id @default(cuid())
  task      Task   @relation(fields: [taskId], references: [id])
  taskId    String
  url       String
  title     String
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String
  createdAt DateTime @default(now())
}
